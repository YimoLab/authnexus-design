      "required": false,
      "default": "3",
      "description": ""
    },
    {
      "name": "options",
      "type": "FieldOption[]",
      "required": false,
      "default": null,
      "description": ""
    },
    {
      "name": "autocomplete",
      "type": "string",
      "required": false,
      "default": null,
      "description": ""
    },
    {
      "name": "spellcheck",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": ""

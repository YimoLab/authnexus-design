{
  "$schema": "../schema.json#",
  "name": "FieldInput",
  "label": {
    "zh": "输入框",
    "en": "FieldInput"
  },
  "group": "form",
  "kind": "vue-component",
  "source": "vue/ui/FieldInput.vue",
  "summary": {
    "zh": "输入框 / 文本域 / 下拉三态合一",
    "en": "输入框 / 文本域 / 下拉三态合一"

      "required": false,
      "default": null,
      "description": ""
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": null,
      "description": ""
    },
    {
      "name": "hint",
      "type": "string",
      "required": false,
      "default": null,
      "description": ""
    },
    {
      "name": "error",
      "type": "string",
      "required": false,
      "default": null,
      "description": ""
    },
    {
